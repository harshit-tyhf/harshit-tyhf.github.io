---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Links from '../../components/Links.astro';
import ShareButton from '../../components/ShareButton.astro';
import { formatDate, published, withBase } from '../../lib/utils';

// Only security entries that have body text get their own page.
export async function getStaticPaths() {
  const entries = await getCollection('security', (e) => published(e) && Boolean(e.body?.trim()));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'security'>;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary} zone="terminal">
  <div class="container page">
    <a class="back" href={withBase('/#cyber')}><Icon name="back" />cd ../cybersec</a>
    <header>
      <p class="meta">
        {d.date && <span>{formatDate(d.date)}</span>}
        {d.category && <a class="cat" href={withBase(`/writeups/?tag=${encodeURIComponent(d.category.toLowerCase())}`)} title="More writeups in this category">{d.category}</a>}
        {d.platform && <span>{d.platform}</span>}
        {d.collab && <span>with {d.collab.team}</span>}
        <ShareButton />
      </p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <Links links={d.links} />
    </header>
    <article class="prose">
      <Content />
    </article>
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1.5rem;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--accent);
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .cat {
    padding: 0 0.5rem;
    background: var(--accent);
    color: var(--on-accent);
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    text-shadow: 0 0 12px rgba(61, 255, 110, 0.4);
  }
  .summary {
    max-width: 60ch;
  }
  .prose {
    color: #d9ffe3;
  }
</style>
