---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, published, withBase, logNumbers } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', published);
  const nums = logNumbers(posts);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, num: nums.get(post.id) } }));
}

interface Props {
  post: CollectionEntry<'blog'>; num?: string
}
const { post, num } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.excerpt}>
  <article class="container page">
    <a class="back" href={withBase('/blog/')}><Icon name="back" />All logs</a>
    <header>
      <p class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="tag">{post.data.tag}</span>{num && <span>Log #{num}</span>}</p>
      <h1>{post.data.title}</h1>
      <p class="excerpt">{post.data.excerpt}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .page {
    /*max-width: 48rem;*/
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1.5rem;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--accent);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 70ch;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }
  .excerpt {
    font-family: var(--font-reading);
    font-size: var(--step-1);
    color: var(--muted);
  }
  /* Side figures: <figure class="side"> hangs in the empty space to the right */
.prose :global(figure) {
  margin: 0;
}
.prose :global(figcaption) {
  margin-top: 0.4rem;
  color: var(--muted);
  font-size: var(--step--1);
}
@media (min-width: 1100px) {
  .prose :global(.side) {
    --side-w: 300px;
    float: right;
    clear: right;
    width: 300px;
    margin-right: calc(-300px - 3rem);
  }
}
</style>
