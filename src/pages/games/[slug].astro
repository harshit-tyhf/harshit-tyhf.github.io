---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Links from '../../components/Links.astro';
import { published, withBase } from '../../lib/utils';

export async function getStaticPaths() {
  const games = await getCollection('games', published);
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props {
  game: CollectionEntry<'games'>;
}
const { game } = Astro.props;
const d = game.data;
const { Content } = await render(game);
const hasBody = Boolean(game.body && game.body.trim());

// Preview image for shared links (Discord, WhatsApp, LinkedIn…): a resized,
// compressed copy of the cover, or of the first screenshot if there's no cover.
const shareSource = d.cover ?? d.screenshots[0];
const shareImage = shareSource
  ? (await getImage({ src: shareSource, width: Math.min(1200, shareSource.width), format: 'jpg', quality: 80 })).src
  : undefined;

// Frame shown before the gameplay video starts: a resized copy, not the full-size original.
const poster = d.video && shareSource
  ? (await getImage({ src: shareSource, width: Math.min(1200, shareSource.width), format: 'webp' })).src
  : undefined;

/** Large, sharp version of an image, shown when it's clicked (see the lightbox in Base.astro). */
const fullSize = async (image: ImageMetadata) =>
  (await getImage({ src: image, width: Math.min(1920, image.width), format: 'webp', quality: 85 })).src;

// Build the media list from whatever exists. Missing pieces are simply skipped.
type Media =
  | { kind: 'game'; label: string; src: string; bg?: string }
  | { kind: 'video'; label: string; src: string }
  | { kind: 'youtube'; label: string; id: string }
  | { kind: 'image'; label: string; image: ImageMetadata; full: string };

const media: Media[] = [];
// Playable game: a "play" link makes the first slide a click-to-play frame.
// Its background is a darkened copy of the cover (or first screenshot); without one it uses the theme colours.
const playUrl = d.links.find((l) => l.kind === 'play' && l.url)?.url;
if (playUrl) {
  const bg = shareSource ? (await getImage({ src: shareSource, width: Math.min(1200, shareSource.width), format: 'webp' })).src : undefined;
  media.push({ kind: 'game', label: 'Play', src: withBase(playUrl), bg });
}
if (d.video) media.push({ kind: 'video', label: 'Gameplay', src: withBase(d.video) });
else if (d.youtube) {
  // Accept either the bare video ID or a full YouTube link (youtu.be/…, watch?v=…, /shorts/…, /embed/…).
  const id = d.youtube.match(/(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/)([\w-]{11})/)?.[1] ?? d.youtube.trim();
  media.push({ kind: 'youtube', label: 'Gameplay', id });
}
for (const [i, image] of d.screenshots.entries()) {
  media.push({ kind: 'image', label: `Shot ${String(i + 1).padStart(2, '0')}`, image, full: await fullSize(image) });
}
const coverFull = media.length === 0 && d.cover ? await fullSize(d.cover) : undefined;

const specLabels: Record<string, string> = {
  engine: 'Engine',
  platform: 'Platform',
  role: 'My role',
  team: 'Team',
  builtIn: 'Built in',
};
const specs = Object.entries(d.specs).filter(([, v]) => v);
if (d.collab) specs.unshift(['collab', `${d.collab.team} (${d.collab.role})`]);
specLabels.collab = 'Made with';
---
<Base title={d.title} description={d.hook} image={shareImage} zone="arcade" noindex={d.unlisted}>
  <div class="container page">
    <a class="back" href={withBase('/#games')}><Icon name="back" />Back to operations</a>

    <header class="title">
      {d.tags.length > 0 && <ul class="tag-list">{d.tags.map((t) => <li class="tag">{t}</li>)}</ul>}
      <h1>{d.title}</h1>
      <p class="hook">{d.hook}</p>
    </header>

    <div class="layout">
      <section class="media" aria-label="Gameplay and screenshots">
        <div class="stage" data-stage>
          {media.length === 0 && (
            d.cover
              ? <Image src={d.cover} alt={`${d.title} key art`} widths={[700, 1200]} sizes="(max-width: 900px) 100vw, 760px" data-full={coverFull} />
              : <div class="empty">Media coming soon</div>
          )}
          {media.map((m, i) => (
            <div class="slide" id={`slide-${i}`} data-slide={i} hidden={i !== 0}>
              {m.kind === 'game' && (
                <div class="game" data-game data-src={m.src}>
                  <button type="button" class:list={['game-start', m.bg && 'has-bg']} data-game-start
                          style={m.bg ? `--game-bg: url('${m.bg}')` : undefined}>
                    <span class="game-icon"><Icon name="play" size={28} /></span>
                    <span class="game-label">Play {d.title}</span>
                    <span class="game-sub">Runs right here in your browser</span>
                  </button>
                  <button type="button" class="game-full" data-game-full hidden>⛶ Fullscreen</button>
                </div>
              )}
              {m.kind === 'video' && (
                <video src={m.src} controls preload="metadata" playsinline poster={poster}>
                  <a href={m.src}>Download the gameplay video</a>
                </video>
              )}
              {m.kind === 'youtube' && (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${m.id}`}
                  title={`${d.title} gameplay video`}
                  loading="lazy"
                  allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                  allowfullscreen></iframe>
              )}
              {m.kind === 'image' && (
                <Image src={m.image} alt={`${d.title}: ${m.label.toLowerCase()}`}
                       widths={[700, 1200, 1600]} sizes="(max-width: 900px) 100vw, 760px" loading={i === 0 ? 'eager' : 'lazy'}
                       data-full={m.full} data-gallery="shots" />
              )}
            </div>
          ))}
          {media.length > 1 && (
            <>
              <button type="button" class="nav nav--prev" data-step="-1" aria-label="Previous screenshot">‹</button>
              <button type="button" class="nav nav--next" data-step="1" aria-label="Next screenshot">›</button>
            </>
          )}
        </div>

        {media.length > 1 && (
          <ul class="thumbs" role="list">
            {media.map((m, i) => (
              <li>
                <button type="button" data-thumb={i} aria-controls={`slide-${i}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                  {m.kind === 'image'
                    ? <Image src={m.image} alt="" width={240} />
                    : d.cover
                      ? <Image src={d.cover} alt="" width={240} />
                      : null}
                  <span class="thumb-label">
                    {m.kind !== 'image' && <Icon name="play" size={12} />}{m.label}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        )}
      </section>

      <aside class="side">
        {d.links.some((l) => l.url) && (
          <div class="panel">
            <h2 class="panel-title">Links</h2>
            <Links links={d.links} variant="button" />
          </div>
        )}
        {specs.length > 0 && (
          <div class="panel">
            <h2 class="panel-title">Specs</h2>
            <dl>
              {specs.map(([k, v]) => (
                <>
                  <dt>{specLabels[k] ?? k}</dt>
                  <dd>
                    {/* "Made with": the team name links to the team's site when teamUrl is set */}
                    {k === 'collab' && d.collab?.teamUrl
                      ? <><a href={d.collab.teamUrl} target="_blank" rel="noopener noreferrer">{d.collab.team}</a> ({d.collab.role})</>
                      : v}
                  </dd>
                </>
              ))}
            </dl>
          </div>
        )}
      </aside>
    </div>

    {(hasBody || d.features.length > 0) && (
      <div class="details">
        {hasBody && (
          <section class="prose brief" aria-label="About the game">
            <Content />
          </section>
        )}
        {d.features.length > 0 && (
          <section class="features">
            <h2>Features</h2>
            <ul>{d.features.map((f) => <li>{f}</li>)}</ul>
          </section>
        )}
      </div>
    )}
  </div>
</Base>

<script>
  // Gallery: thumbnails, ‹ › arrows, ← → keys and swipe all switch the visible slide.
  const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  let current = 0;

  // Playable game frame: the game only loads when clicked. On phones and tablets it opens on its own instead.
  const game = document.querySelector<HTMLElement>('[data-game]');
  const gameStart = game?.querySelector<HTMLButtonElement>('[data-game-start]');
  const gameFull = game?.querySelector<HTMLButtonElement>('[data-game-full]');
  const stopGame = () => {
    const frame = game?.querySelector('iframe');
    if (frame && gameStart && gameFull) { frame.replaceWith(gameStart); gameFull.hidden = true; }
  };
  if (game && gameStart && gameFull) {
    gameStart.addEventListener('click', () => {
      // Only devices with no mouse or trackpad at all (phones, tablets). Narrow windows and
      // touchscreen laptops still play in the frame. Checked at click time, not page load.
      const phone = matchMedia('(hover: none) and (pointer: coarse)').matches;
      if (phone) { location.href = game.dataset.src!; return; }
      const frame = document.createElement('iframe');
      // "?site" tells the game it's in my site's frame, not on YouTube (see the game's ON_MY_SITE).
      const src = game.dataset.src!;
      frame.src = src + (src.includes('?') ? '&' : '?') + 'site';
      frame.title = gameStart.querySelector('.game-label')?.textContent ?? 'Game';
      frame.allow = 'fullscreen; autoplay';
      gameStart.replaceWith(frame);
      gameFull.hidden = false;
      frame.focus();
    });
    gameFull.addEventListener('click', () => game.requestFullscreen?.());
  }

  const show = (index: number) => {
    if (!slides.length) return;
    current = (index + slides.length) % slides.length; // loop around at both ends
    slides.forEach((slide, i) => {
      slide.hidden = i !== current;
      if (i !== current) slide.querySelector('video')?.pause();
      if (i !== current && slide.contains(game)) stopGame(); // switching away closes the game (and its sound)
    });
    thumbs.forEach((b, i) => b.setAttribute('aria-pressed', String(i === current)));
  };

  thumbs.forEach((btn, i) => btn.addEventListener('click', () => show(i)));
  document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) =>
    btn.addEventListener('click', () => show(current + Number(btn.dataset.step))),
  );

  if (stage && slides.length > 1) {
    // Arrow keys while the viewer or its thumbnails have focus (not while the lightbox is open).
    stage.closest('.media')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (document.querySelector('.lightbox[open]')) return;
      if (key === 'ArrowLeft') show(current - 1);
      else if (key === 'ArrowRight') show(current + 1);
    });

    // Swipe left/right on touch screens.
    let startX = 0;
    let startY = 0;
    stage.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 1.5rem;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--accent);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .title {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }
  .hook {
    max-width: 48rem;
    color: var(--muted);
    font-size: var(--step-1);
  }
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: flex-start;
  }
  .media {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    background: repeating-linear-gradient(135deg, var(--surface) 0 14px, var(--bg) 14px 28px);
    overflow: hidden;
  }
  .slide,
  .stage > :global(img) {
    width: 100%;
    height: 100%;
  }
  .slide :global(:is(img, video, iframe)) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
    background: #000;
  }
  .stage > :global(img) {
    object-fit: cover;
  }
  /* ‹ › arrows on the main viewer */
  .nav {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 56px;
    transform: translateY(-50%);
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    color: var(--text-strong);
    font: 400 2rem / 1 var(--font-body);
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .nav--prev {
    left: 0.6rem;
  }
  .nav--next {
    right: 0.6rem;
  }
  .stage:hover .nav,
  .nav:focus-visible {
    opacity: 1;
  }
  .nav:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  /* Playable game frame */
  .game {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--bg);
  }
  .game-start {
    position: absolute;
    inset: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem;
    border: 0;
    color: var(--text-strong);
    font-family: var(--font-body);
    cursor: pointer;
    /* No cover image: theme colours with a soft accent glow */
    background:
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 60%),
      linear-gradient(var(--surface), var(--bg));
  }
  .game-start.has-bg {
    /* Cover image, darkened so the text stays readable */
    background:
      linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.75)),
      var(--game-bg) center / cover no-repeat;
  }
  .game-icon {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border: 2px solid var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    transition: background-color 0.15s, color 0.15s;
  }
  .game-start:hover .game-icon,
  .game-start:focus-visible .game-icon {
    background: var(--accent);
    color: var(--on-accent);
  }
  .game-label {
    font: 700 var(--step-2) var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: center;
  }
  .game-sub {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .game-start.has-bg .game-sub {
    color: rgba(255, 255, 255, 0.8);
  }
  .game-full {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 2;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    color: var(--text-strong);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .game-full:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .empty {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--muted);
  }
  .thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 0.6rem;
  }
  .thumbs button {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 2px solid var(--line);
    background: var(--surface);
    color: var(--text-strong);
    cursor: pointer;
    overflow: hidden;
  }
  .thumbs button[aria-pressed='true'] {
    border-color: var(--accent);
  }
  .thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
  }
  .thumb-label {
    position: absolute;
    left: 0.35rem;
    bottom: 0.35rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.1rem 0.4rem;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    font: 0.6875rem var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .side {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .panel-title {
    color: var(--accent);
    font-size: var(--step-0);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .panel :global(.btn--block) {
    color: var(--text-strong);
    border-color: var(--line-strong);
  }
  .panel :global(li:first-child .btn--block) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.1rem;
    font-size: 0.875rem;
  }
  dt {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  dd {
    margin: 0;
    white-space: pre-line; /* show \n as line break */
  }
  .details {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
  }
  .brief {
    flex: 999 1 480px;
    min-width: 0;
  }
  .features {
    flex: 1 1 280px;
  }
  .features h2 {
    font-size: var(--step-2);
    margin-bottom: 0.8rem;
  }
  .features ul {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
