---
/** Every game. The homepage only shows the first few (see GAMES_ON_HOME in index.astro). */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import GameCard from '../../components/GameCard.astro';
import { listed, withBase } from '../../lib/utils';

const games = (await getCollection('games', listed)).sort((a, b) => a.data.order - b.data.order);
const soloGames = games.filter((g) => !g.data.collab);
const collabGames = games.filter((g) => g.data.collab);
---
<Base title="Games" description="Every game I've made, solo and with teams." zone="arcade">
  <div class="container page">
    <a class="back" href={withBase('/#games')}><Icon name="back" />Back to operations</a>
    <header>
      <h1>Game dev</h1>
      <p class="count">{games.length} {games.length === 1 ? 'operation' : 'operations'}</p>
    </header>

    <div class="zone-panel">
      {soloGames.length > 0 && (
        <div class="grid-cards">
          {soloGames.map((g, i) => <GameCard game={g} level={i + 1} />)}
        </div>
      )}
      {collabGames.length > 0 && (
        <div class="sub">
          <h2 class="sub-title"><Icon name="users" />Co-op missions</h2>
          <div class="grid-cards">
            {collabGames.map((g) => <GameCard game={g} />)}
          </div>
        </div>
      )}
      {games.length === 0 && <p class="count">No games yet.</p>}
    </div>
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 1.5rem;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--accent);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }
  .count {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .zone-panel {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .sub {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line-strong);
  }
  .sub-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
    font: 600 var(--step--1) var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
