---
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/vt323/400.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/theme.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import defaultShare from '../assets/share-default.png';
import squareShare from '../assets/share-square.png';
import { site } from '../data/site';
import { withBase } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string; // social preview image (absolute URL or /path); pages without one use the default banner
  zone?: 'arcade' | 'terminal';
  // Link-preview style: 'large' = big banner under the text (default),
  // 'small' = small square logo beside the title and description (used by logs and writeups).
  card?: 'large' | 'small';
  // true = ask search engines not to index this page (unlisted entries). Also keeps it out of the sitemap.
  noindex?: boolean;
}
const { title, description = site.description, image, zone, card = 'large', noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview image for shared links. Pages that don't pass their own (game pages do) get
// the site banner (src/assets/share-default.png), or for small cards the square logo
// (src/assets/share-square.png).
const shareSrc =
  image ??
  (card === 'small'
    ? (await getImage({ src: squareShare, width: 400, format: 'png' })).src
    : (await getImage({ src: defaultShare, format: 'jpg', quality: 85 })).src);
const ogImage = new URL(shareSrc, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — logs`} href={withBase('/rss.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={card === 'small' ? 'summary' : 'summary_large_image'} />
    <!-- Visitor stats: https://pseudoelf.goatcounter.com (your own localhost visits aren't counted) -->
    <script is:inline data-goatcounter="https://pseudoelf.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class:list={[zone && `zone-${zone}`]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href={withBase('/rss.xml')}>RSS</a>
    </footer>
    
    <dialog class="lightbox" id="lightbox" aria-label="Enlarged image">
  <button type="button" class="lightbox-close" aria-label="Close">✕</button>
  <button type="button" class="lightbox-nav lightbox-nav--prev" data-lb-step="-1" aria-label="Previous image" hidden>‹</button>
  <button type="button" class="lightbox-nav lightbox-nav--next" data-lb-step="1" aria-label="Next image" hidden>›</button>
  <img alt="" />
  <p class="lightbox-caption"></p>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const big = dialog.querySelector('img')!;
    const caption = dialog.querySelector('.lightbox-caption')!;
    const navButtons = [...dialog.querySelectorAll<HTMLButtonElement>('[data-lb-step]')];
    let group: HTMLImageElement[] = [];
    let index = 0;

    // Images that can be flipped through together: same data-gallery (game screenshots),
    // or all images in the same post. Anything else opens on its own.
    const groupFor = (img: HTMLImageElement) => {
      if (img.dataset.gallery)
        return [...document.querySelectorAll<HTMLImageElement>(`img[data-gallery="${img.dataset.gallery}"]`)];
      const post = img.closest('.prose');
      return post ? [...post.querySelectorAll<HTMLImageElement>('img')] : [img];
    };

    const showImage = (i: number) => {
      index = (i + group.length) % group.length; // loop around at both ends
      const img = group[index];
      big.src = img.dataset.full || img.currentSrc || img.src; // data-full = a larger version, if there is one
      big.alt = img.alt;
      const text = img.closest('figure')?.querySelector('figcaption')?.textContent ?? img.alt;
      caption.textContent = group.length > 1 ? `${index + 1} / ${group.length}${text ? ` · ${text}` : ''}` : text;
    };

    const open = (img: HTMLImageElement) => {
      group = groupFor(img);
      navButtons.forEach((b) => (b.hidden = group.length < 2));
      showImage(group.indexOf(img));
      dialog.showModal();
    };

    navButtons.forEach((b) =>
      b.addEventListener('click', (e) => {
        e.stopPropagation(); // don't close the lightbox
        showImage(index + Number(b.dataset.lbStep));
      }),
    );
    dialog.addEventListener('keydown', (e) => {
      if (group.length < 2) return;
      if (e.key === 'ArrowLeft') showImage(index - 1);
      else if (e.key === 'ArrowRight') showImage(index + 1);
    });
    // Swipe left/right on touch screens.
    let startX = 0;
    let swiped = false;
    dialog.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      swiped = false;
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (group.length > 1 && Math.abs(dx) > 40) {
        swiped = true;
        showImage(index + (dx < 0 ? 1 : -1));
      }
    }, { passive: true });

    document.querySelectorAll<HTMLImageElement>('.prose img, img[data-full]').forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `Enlarge image${img.alt ? `: ${img.alt}` : ''}`);
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(img);
        }
      });
    });

    // Clicking anywhere (image, background or ✕) closes it. Escape also works.
    dialog.addEventListener('click', () => {
      if (swiped) {
        swiped = false; // a swipe isn't a click
        return;
      }
      dialog.close();
    });
  }
</script>
  </body>
</html>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 3rem;
    margin-top: var(--section-gap);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
