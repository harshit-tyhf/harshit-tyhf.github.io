---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Links from './Links.astro';
import { withBase } from '../lib/utils';

interface Props {
  game: CollectionEntry<'games'>;
  level?: number; // not used for co-op games
}
const { game, level } = Astro.props;
const d = game.data;
const href = withBase(`/games/${game.id}/`);
const hasVideo = Boolean(d.video || d.youtube);
const shots = d.screenshots.length;
// Still image for the card: the cover if there is one, otherwise the first screenshot.
const still = d.cover ?? d.screenshots[0];
---
<article class="card">
  <a class="card-main" href={href}>
    <div class="media">
      {d.previewLoop ? (
        <video src={withBase(d.previewLoop)} muted loop playsinline autoplay preload="metadata"
               poster={still?.src} data-motion aria-hidden="true"></video>
      ) : still ? (
        <Image src={still} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 360px" />
      ) : (
        <div class="placeholder" aria-hidden="true">No preview yet</div>
      )}
      <span class="lvl">{d.collab ? 'Co-op' : `LVL ${String(level ?? 0).padStart(2, '0')}`}</span>
      {hasVideo && <span class="badge badge--left"><Icon name="play" size={14} />Gameplay</span>}
      {shots > 0 && <span class="badge badge--right"><Icon name="image" size={14} />{shots}</span>}
    </div>
    <div class="body">
      <h3>{d.title}</h3>
      {d.collab && <p class="crew">With {d.collab.team} · {d.collab.role}</p>}
      <p>{d.hook}</p>
    </div>
  </a>
  <div class="foot">
    {d.tags.length > 0 && (
      <ul class="tag-list">{d.tags.map((t) => <li class="tag">{t}</li>)}</ul>
    )}
    <Links links={d.links.filter((l) => l.kind === 'github' || l.kind === 'itch' || l.kind === 'steam')} variant="icon" />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card-main {
    color: inherit;
    text-decoration: none;
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, var(--surface) 0 14px, var(--bg) 14px 28px);
  }
  .media :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .lvl,
  .badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.55rem;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .lvl {
    top: 0.6rem;
    right: 0.6rem;
    border: 1px solid var(--accent);
    color: var(--accent);
  }
  .badge {
    bottom: 0.6rem;
    color: var(--text-strong);
  }
  .badge--left {
    left: 0.6rem;
  }
  .badge--right {
    right: 0.6rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem 1.2rem 0.5rem;
  }
  h3 {
    font-size: var(--step-2);
  }
  .body p {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .body .crew {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding: 0.5rem 1.2rem 1.2rem;
  }
</style>
