---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Links from './Links.astro';
import { withBase } from '../lib/utils';

interface Props {
  game: CollectionEntry<'games'>;
  level?: number; // not used for co-op games
}
const { game, level } = Astro.props;
const d = game.data;
const href = withBase(`/games/${game.id}/`);
const hasVideo = Boolean(d.video || d.youtube);
const shots = d.screenshots.length;
// Still image for the card: the cover if there is one, otherwise the first screenshot.
const still = d.cover ?? d.screenshots[0];
// Which links get an icon button on the card (the rest show on the game's page).
const CARD_LINK_KINDS = ['github', 'itch', 'steam', 'googleplay', 'appstore'];
// Frame shown before the preview loop starts: a resized copy, not the full-size original.
const poster = d.previewLoop && still
  ? (await getImage({ src: still, width: Math.min(700, still.width), format: 'webp' })).src
  : undefined;
---
<article class="card">
  <div class="card-main">
    <div class="media">
      {d.previewLoop ? (
        <video src={withBase(d.previewLoop)} muted loop playsinline autoplay preload="metadata"
               poster={poster} data-motion aria-hidden="true"></video>
      ) : still ? (
        <Image src={still} alt="" widths={[400, 700]} sizes="(max-width: 700px) 100vw, 360px" />
      ) : (
        <div class="placeholder" aria-hidden="true">No preview yet</div>
      )}
      <span class="lvl">{d.collab ? 'Co-op' : `LVL ${String(level ?? 0).padStart(2, '0')}`}</span>
      {hasVideo && <span class="badge badge--left"><Icon name="play" size={14} />Gameplay</span>}
      {shots > 0 && <span class="badge badge--right"><Icon name="image" size={14} />{shots}</span>}
    </div>
    <div class="body">
      <!-- The title link is stretched over the whole image + text area, so clicking anywhere there opens the game. -->
      <h3><a class="stretched" href={href}>{d.title}</a></h3>
      {d.collab && (
        <p class="crew">
          {d.collab.teamUrl
            ? <a class="team-link" href={d.collab.teamUrl} target="_blank" rel="noopener noreferrer">With {d.collab.team}</a>
            : <>With {d.collab.team}</>}
          {' · '}{d.collab.role}
        </p>
      )}
      <p>{d.hook}</p>
    </div>
  </div>
  <div class="foot">
    {d.tags.length > 0 && (
      <ul class="tag-list">{d.tags.map((t) => <li class="tag">{t}</li>)}</ul>
    )}
    <Links links={d.links.filter((l) => CARD_LINK_KINDS.includes(l.kind))} variant="icon" />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card-main {
    position: relative; /* the stretched title link covers this area */
  }
  .stretched {
    color: inherit;
    text-decoration: none;
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .stretched:focus-visible {
    outline: none;
  }
  .card:has(.stretched:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .team-link {
    position: relative;
    z-index: 1; /* sits above the stretched link, so it opens the studio page instead */
    color: inherit;
    text-underline-offset: 3px;
  }
  .team-link:hover {
    color: var(--text-strong);
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, var(--surface) 0 14px, var(--bg) 14px 28px);
  }
  .media :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .lvl,
  .badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.55rem;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .lvl {
    top: 0.6rem;
    right: 0.6rem;
    border: 1px solid var(--accent);
    color: var(--accent);
  }
  .badge {
    bottom: 0.6rem;
    color: var(--text-strong);
  }
  .badge--left {
    left: 0.6rem;
  }
  .badge--right {
    right: 0.6rem;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem 1.2rem 0.5rem;
  }
  h3 {
    font-size: var(--step-2);
  }
  .body p {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .body .crew {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding: 0.5rem 1.2rem 1.2rem;
  }
</style>
