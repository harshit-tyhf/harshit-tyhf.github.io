---
/**
 * <Icon name="github" />
 * Brand logos come from the Simple Icons package (https://simpleicons.org).
 * To add one: find its export name on simpleicons.org (e.g. siRust) and add it to BRAND.
 * Anything not in BRAND falls back to the generic line icons in GENERIC.
 */
import {
  siGithub, siItchdotio, siSteam, siYoutube, siUnity, siGodotengine, siBlender,
  siWireshark, siBurpsuite, siPython, siCplusplus, siGnubash, siLinux, siGit, siDocker,
  siHackthebox, siTryhackme, siKalilinux,
} from 'simple-icons';

interface Props {
  name: string;
  size?: number;
  label?: string; // set this when the icon is the only content of a link/button
}
const { name, size = 20, label } = Astro.props;

const BRAND: Record<string, { path: string }> = {
  github: siGithub, itch: siItchdotio, steam: siSteam, youtube: siYoutube,
  unity: siUnity, godot: siGodotengine, blender: siBlender,
  wireshark: siWireshark, burpsuite: siBurpsuite, python: siPython, cplusplus: siCplusplus,
  bash: siGnubash, linux: siLinux, git: siGit, docker: siDocker,
  hackthebox: siHackthebox, tryhackme: siTryhackme, kali: siKalilinux,
};

const GENERIC: Record<string, string> = {
  code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/>',
  terminal: '<rect x="3" y="4" width="18" height="16"/><path d="M7 9l3 3-3 3M13 15h4"/>',
  cube: '<path d="M12 2l9 5v10l-9 5-9-5V7z"/><path d="M12 12l9-5M12 12v10M12 12L3 7"/>',
  gamepad: '<rect x="2" y="7" width="20" height="11" rx="4"/><path d="M7 10.5v4M5 12.5h4"/><circle cx="16" cy="11.5" r=".6"/><circle cx="18" cy="13.5" r=".6"/>',
  shield: '<path d="M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  bug: '<rect x="7" y="7" width="10" height="13" rx="5"/><path d="M12 7V4M7 12H3M21 12h-4M7 17l-3 2M17 17l3 2M9 4l1.5 3M15 4l-1.5 3"/>',
  network: '<path d="M2 12h4l3-7 4 14 3-7h6"/>',
  branch: '<circle cx="6" cy="5" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="7" r="2"/><path d="M6 7v10M18 9c0 5-7 4-11 8"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"/>',
  docs: '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h7"/>',
  download: '<path d="M12 4v11M7 10l5 5 5-5M4 20h16"/>',
  email: '<rect x="3" y="5" width="18" height="14"/><path d="M3 6l9 7 9-7"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>',
  web: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>',
  play: '<path d="M8 5l11 7-11 7z" fill="currentColor"/>',
  image: '<rect x="3" y="5" width="18" height="14"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-9 8"/>',
  back: '<path d="M15 6l-6 6 6 6"/>',
  users: '<circle cx="9" cy="8" r="3"/><path d="M3 20c.5-3.5 3-5 6-5s5.5 1.5 6 5"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2c2.6.2 4.5 1.8 5 4.8"/>',
};

const brand = BRAND[name];
const generic = GENERIC[name] ?? GENERIC.code;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
{brand ? (
  <svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" {...a11y}>
    <path d={brand.path} />
  </svg>
) : (
  <svg
    class="icon"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    {...a11y}
    set:html={generic}
  />
)}

<style>
  .icon {
    flex: none;
  }
</style>
